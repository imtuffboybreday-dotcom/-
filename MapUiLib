                Btn.MouseButton1Click:Connect(function()
                    open = not open
                    local height = open and (#list * 30) or 0
                    Tween(Holder, { Size = UDim2.new(1, 0, 0, 34 + height) }, 0.2)
                    Tween(ListFrame, { Size = UDim2.new(1, 0, 0, height) }, 0.2)
                end)

                return {
                    Set = function(_, value)
                        selected = value
                        Btn.Text = "  " .. name .. " : " .. selected
                        callback(selected)
                    end,
                    Refresh = function(_, newList)
