                    Font = Enum.Font.GothamBold,
                    Text = currentKey.Name,
                    TextColor3 = theme.SchemeColor,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Right,
                })

                local listening = false

                Holder.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        listening = true
                        KeyLabel.Text = "..."
                    end
                end)

                UserInputService.InputBegan:Connect(function(input, gp)
                    if listening and not gp then
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            currentKey = input.KeyCode
                            KeyLabel.Text = currentKey.Name
                            listening = false
                        end
                    elseif not gp and input.KeyCode == currentKey then
                        callback()
                    end
                end)

                return {
                    Set = function(_, key)
                        currentKey = key
                        KeyLabel.Text = key.Name
                    end
                }
            end

            -------------------------------------------------
            -- LABEL
            -------------------------------------------------
            function Elements:NewLabel(text)
                local Lbl = Create("TextLabel", {
                    Parent = SectionFrame,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 22),
                    Font = Enum.Font.Gotham,
                    Text = text or "",
                    TextColor3 = theme.TextColor,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextWrapped = true,
                    LayoutOrder = #SectionFrame:GetChildren(),
                })
                return {
                    Update = function(_, newText)
                        Lbl.Text = newText
                    end
                }
            end

            -------------------------------------------------
            -- PARAGRAPH / INFO
            -------------------------------------------------
            function Elements:NewParagraph(title, content)
                local Holder = Create("Frame", {
                    Parent = SectionFrame,
                    BackgroundColor3 = theme.Background,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 50),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    LayoutOrder = #SectionFrame:GetChildren(),
                })
                Create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = Holder })
                Create("UIPadding", {
                    Parent = Holder,
                    PaddingTop = UDim.new(0, 8),
                    PaddingBottom = UDim.new(0, 8),
                    PaddingLeft = UDim.new(0, 10),
                    PaddingRight = UDim.new(0, 10),
                })
                Create("UIListLayout", {
                    Parent = Holder,
                    SortOrder = Enum.SortOrder.LayoutOrder,
                    Padding = UDim.new(0, 4),
                })

                local TitleLbl = Create("TextLabel", {
                    Parent = Holder,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 16),
                    Font = Enum.Font.GothamBold,
                    Text = title or "Info",
                    TextColor3 = theme.SchemeColor,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                })

                local ContentLbl = Create("TextLabel", {
                    Parent = Holder,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    Font = Enum.Font.Gotham,
                    Text = content or "",
                    TextColor3 = theme.TextColor,
                    TextSize = 11,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextWrapped = true,
                })

                return {}
            end

            return Elements
        end

        return Sections
    end

    -- Notification helper
    function Library:Notify(title, content, duration)
        title = title or "Notification"
        content = content or ""
        duration = duration or 4

        local Notif = Create("Frame", {
            Parent = ScreenGui,
            BackgroundColor3 = theme.Header,
            BorderSizePixel = 0,
            Position = UDim2.new(1, 20, 1, -90),
            Size = UDim2.new(0, 280, 0, 70),
            ZIndex = 100,
        })
        Create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = Notif })
        Create("UIStroke", { Color = theme.SchemeColor, Thickness = 1.5, Parent = Notif })

        local NTitle = Create("TextLabel", {
            Parent = Notif,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 12, 0, 8),
            Size = UDim2.new(1, -24, 0, 20),
            Font = Enum.Font.GothamBold,
            Text = title,
            TextColor3 = theme.TextColor,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left,
        })

        local NContent = Create("TextLabel", {
            Parent = Notif,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 12, 0, 30),
            Size = UDim2.new(1, -24, 0, 30),
            Font = Enum.Font.Gotham,
            Text = content,
            TextColor3 = Color3.fromRGB(180, 180, 190),
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true,
        })

        Tween(Notif, { Position = UDim2.new(1, -300, 1, -90) }, 0.35)

        task.delay(duration, function()
            Tween(Notif, { Position = UDim2.new(1, 20, 1, -90) }, 0.3)
            task.wait(0.35)
            Notif:Destroy()
        end)
    end

    return Tabs
end

-- Destroy method
function Library:Destroy()
    for _, gui in pairs(CoreGui:GetChildren()) do
        if gui.Name == "333IdCBS_Lib" then
            gui:Destroy()
        end
    end
    Library.Flags = {}
end

return Library
