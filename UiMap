                    Parent = Row,

                    BackgroundColor3 =
                        Color3.fromRGB(40, 50, 70),

                    BorderSizePixel = 0,

                    Position = UDim2.new(0, 0, 0, 43),

                    Size = UDim2.new(1, 0, 0, 6),
                })

