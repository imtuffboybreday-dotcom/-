                    AutoButtonColor = false,
                })

                Create("UICorner", {
                    CornerRadius = UDim.new(0, 7),

                    Parent = Btn,
                })

                Btn.MouseButton1Click:Connect(callback)

                Btn.MouseEnter:Connect(function()

                    Tween(
                        Btn,
                        {
                            BackgroundColor3 =
                                Theme.AccentDark
                        }
                    )

                end)

                Btn.MouseLeave:Connect(function()

                    Tween(
                        Btn,
                        {
                            BackgroundColor3 =
                                Theme.Accent
                        }
                    )

                end)

                return {}
            end

            -- ==================== DROPDOWN ====================

            function Elements:NewDropdown(
                name,
                tip,
                list,
                callback
            )

                name = name or "Dropdown"
                tip = tip or ""

                list = list or {}

                callback = callback or function() end

                local selected =
                    list[1] or "None"

                local Row = Create("Frame", {
                    Parent = Card,

                    BackgroundTransparency = 1,

                    Size = UDim2.new(1, 0, 0, 42),

                    LayoutOrder = 40 + #Card:GetChildren(),
                })

                local RowIcon = Create("ImageLabel", {
                    Parent = Row,

                    BackgroundTransparency = 1,

                    Position = UDim2.new(0, 0, 0.5, -10),

                    Size = UDim2.new(0, 20, 0, 20),

                    Image = Icons.Target,

                    ImageColor3 = Theme.Accent,
                })

                local RowTitle = Create("TextLabel", {
                    Parent = Row,

                    BackgroundTransparency = 1,

                    Position = UDim2.new(0, 29, 0, 3),

                    Size = UDim2.new(0.42, 0, 0, 17),

                    Font = Enum.Font.GothamMedium,

                    Text = name,

                    TextColor3 = Theme.Text,

                    TextSize = 12,

                    TextXAlignment = Enum.TextXAlignment.Left,
                })

                local RowTip = Create("TextLabel", {
                    Parent = Row,

                    BackgroundTransparency = 1,

                    Position = UDim2.new(0, 29, 0, 21),

                    Size = UDim2.new(0.42, 0, 0, 14),

                    Font = Enum.Font.Gotham,

                    Text = tip,

                    TextColor3 = Theme.TextDim,

                    TextSize = 9,

                    TextXAlignment = Enum.TextXAlignment.Left,
                })

                local DropBtn = Create("TextButton", {
                    Parent = Row,

                    BackgroundColor3 = Theme.Background,

                    BorderSizePixel = 0,

                    Position = UDim2.new(0.48, 0, 0.5, -13),

                    Size = UDim2.new(0.52, 0, 0, 26),

                    Font = Enum.Font.GothamMedium,

                    Text = selected .. "  ▼",

                    TextColor3 = Theme.Text,

                    TextSize = 10,

                    AutoButtonColor = false,
                })

                Create("UICorner", {
                    CornerRadius = UDim.new(0, 6),

                    Parent = DropBtn,
                })

                DropBtn.MouseButton1Click:Connect(function()

                    if #list == 0 then
                        return
                    end

                    local idx =
                        table.find(list, selected)
                        or 1

                    idx = idx % #list + 1

                    selected = list[idx]

                    DropBtn.Text =
                        selected .. "  ▼"

                    callback(selected)

                end)

                return {

                    Set = function(_, v)

                        selected = v

                        DropBtn.Text =
                            selected .. "  ▼"

                        callback(selected)

                    end,

                    Get = function()
                        return selected
                    end,
                }
            end

            -- ==================== KEYBIND ====================

            function Elements:NewKeybind(
                name,
                tip,
                default,
                callback
            )

                name = name or "Keybind"
                tip = tip or ""

                default =
                    default or Enum.KeyCode.E

                callback =
                    callback or function() end

                local current = default
                local listening = false

                local Row = Create("Frame", {
                    Parent = Card,

                    BackgroundTransparency = 1,

                    Size = UDim2.new(1, 0, 0, 42),

                    LayoutOrder = 50 + #Card:GetChildren(),
                })

                local RowIcon = Create("ImageLabel", {
                    Parent = Row,

                    BackgroundTransparency = 1,

                    Position = UDim2.new(0, 0, 0.5, -10),

                    Size = UDim2.new(0, 20, 0, 20),

                    Image = Icons.Key,

                    ImageColor3 = Theme.Accent,
                })

                local RowTitle = Create("TextLabel", {
                    Parent = Row,

                    BackgroundTransparency = 1,

                    Position = UDim2.new(0, 29, 0, 3),

                    Size = UDim2.new(0.5, 0, 0, 17),

                    Font = Enum.Font.GothamMedium,

                    Text = name,

                    TextColor3 = Theme.Text,

                    TextSize = 12,

                    TextXAlignment = Enum.TextXAlignment.Left,
                })

                local RowTip = Create("TextLabel", {
                    Parent = Row,

                    BackgroundTransparency = 1,

                    Position = UDim2.new(0, 29, 0, 21),

                    Size = UDim2.new(0.5, 0, 0, 14),

                    Font = Enum.Font.Gotham,

                    Text = tip,

                    TextColor3 = Theme.TextDim,

                    TextSize = 9,

                    TextXAlignment = Enum.TextXAlignment.Left,
                })

                local KeyBtn = Create("TextButton", {
                    Parent = Row,

                    BackgroundColor3 = Theme.Background,

                    BorderSizePixel = 0,

                    Position = UDim2.new(1, -62, 0.5, -13),

                    Size = UDim2.new(0, 58, 0, 26),

                    Font = Enum.Font.GothamBold,

                    Text = current.Name,

                    TextColor3 = Theme.Text,

                    TextSize = 10,

                    AutoButtonColor = false,
                })

                Create("UICorner", {
                    CornerRadius = UDim.new(0, 6),

                    Parent = KeyBtn,
                })

                KeyBtn.MouseButton1Click:Connect(function()

                    listening = true

                    KeyBtn.Text = "..."

                end)

                UserInputService.InputBegan:Connect(function(
                    input,
                    gp
                )

                    if gp then
                        return
                    end

                    if listening then

                        if input.UserInputType ==
                            Enum.UserInputType.Keyboard then

                            current = input.KeyCode

                            KeyBtn.Text =
                                current.Name

                            listening = false
                        end

                        return
                    end

                    if input.UserInputType ==
                        Enum.UserInputType.Keyboard

                    and input.KeyCode ==
                        current then

                        callback()
                    end

                end)

                return {}
            end

            return Elements
        end

        return Sections
    end

    -- ==================== NOTIFICATION ====================

    function Library:Notify(
        title,
        content,
        duration
    )

        title = title or "Notification"
        content = content or ""

        duration = duration or 4

        local Notif = Create("Frame", {
            Parent = ScreenGui,

            BackgroundColor3 = Theme.Card,

            BorderSizePixel = 0,

            AnchorPoint = Vector2.new(1, 1),

            Position = UDim2.new(
                1,
                20,
                1,
                -20
            ),

            Size = UDim2.new(
                0,
                260,
                0,
                68
            ),

            ZIndex = 200,
        })

        Create("UICorner", {
            CornerRadius = UDim.new(0, 11),

            Parent = Notif,
        })

        Create("UIStroke", {
            Color = Theme.Accent,

            Thickness = 1.5,

            Parent = Notif,
        })

        local AccentBar = Create("Frame", {
            Parent = Notif,

            BackgroundColor3 = Theme.Accent,

            BorderSizePixel = 0,

            Size = UDim2.new(0, 4, 1, 0),

            ZIndex = 201,
        })

        Create("UICorner", {
            CornerRadius = UDim.new(0, 4),

            Parent = AccentBar,
        })

        local NIcon = Create("ImageLabel", {
            Parent = Notif,

            BackgroundTransparency = 1,

            Position = UDim2.new(0, 14, 0.5, -11),

            Size = UDim2.new(0, 22, 0, 22),

            Image = Icons.Crown,

            ImageColor3 = Theme.Accent,

            ZIndex = 201,
        })

        local NTitle = Create("TextLabel", {
            Parent = Notif,

            BackgroundTransparency = 1,

            Position = UDim2.new(0, 46, 0, 10),

            Size = UDim2.new(1, -58, 0, 18),

            Font = Enum.Font.GothamBold,

            Text = title,

            TextColor3 = Theme.Text,

            TextSize = 12,

            TextXAlignment = Enum.TextXAlignment.Left,

            ZIndex = 201,
        })

        local NContent = Create("TextLabel", {
            Parent = Notif,

            BackgroundTransparency = 1,

            Position = UDim2.new(0, 46, 0, 30),

            Size = UDim2.new(1, -58, 0, 27),

            Font = Enum.Font.Gotham,

            Text = content,

            TextColor3 = Theme.TextDim,

            TextSize = 9,

            TextXAlignment = Enum.TextXAlignment.Left,

            TextWrapped = true,

            ZIndex = 201,
        })

        -- Start offscreen

        Tween(
            Notif,
            {
                Position = UDim2.new(
                    1,
                    -12,
                    1,
                    -20
                )
            },
            0.35
        )

        task.delay(duration, function()

            if not Notif.Parent then
                return
            end

            Tween(
                Notif,
                {
                    Position = UDim2.new(
                        1,
                        20,
                        1,
                        -20
                    )
                },
                0.3
            )

            task.wait(0.35)

            if Notif then
                Notif:Destroy()
            end

        end)
    end

    return Tabs
end

-- ==================== DESTROY ====================

function Library:Destroy()

    for _, g in pairs(CoreGui:GetChildren()) do

        if g.Name == "333IdCBS_Mobile" then
            g:Destroy()
        end

    end
end

return Library
