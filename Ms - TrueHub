local ScriptbloxApis = Window:CreateTab("ScriptbloxApis")

local HttpService = game:GetService("HttpService")

local CurrentFilter = "All"
local LastResults = {}

local function MatchesFilter(scriptData)

    if CurrentFilter == "All" then
        return true
    end

    local hasKey = scriptData.key == true

    if CurrentFilter == "Keyless" then
        return not hasKey
    end

    if CurrentFilter == "Key" then
        return hasKey
    end

    if CurrentFilter == "Paid" then
        return scriptData.paid == true
            or scriptData.isPaid == true
            or scriptData.keyType == "paid"
    end

    return true
end

Window:AddDropdown(
    ScriptbloxApis,
    "Filter",
    "Filter ScriptBlox results",
    {
        "All",
        "Keyless",
        "Key",
        "Paid"
    },
    function(value)

        CurrentFilter = value

        print(
            "[ScriptBlox] Filter:",
            CurrentFilter
        )

        if #LastResults > 0 then

            local count = 0

            for _, scriptData in ipairs(LastResults) do

                if MatchesFilter(scriptData) then
                    count = count + 1
                end

            end

            print(
                "[ScriptBlox] Matching results:",
                count
            )
        end
    end
)

Window:AddInput(
    ScriptbloxApis,
    "ScriptBlox Search",
    "Btw This Is Beta",
    "Enter game or script name...",
    function(query)

        if not query
            or query:gsub("%s+", "") == "" then
            return
        end

        local encodedQuery =
            HttpService:UrlEncode(query)

        local success, response = pcall(function()

            return game:HttpGet(
                "https://scriptblox.com/api/script/search?q="
                .. encodedQuery
                .. "&max=20"
            )

        end)

        if not success then

            warn(
                "[ScriptBlox] Request failed:",
                response
            )

            return
        end

        local decodeSuccess, data =
            pcall(function()

                return HttpService:JSONDecode(
                    response
                )

            end)

        if not decodeSuccess then

            warn(
                "[ScriptBlox] Failed to decode response"
            )

            return
        end

        if not data
            or not data.result
            or not data.result.scripts then

            warn(
                "[ScriptBlox] No results"
            )

            return
        end

        LastResults =
            data.result.scripts

        local shown = 0

        for _, scriptData in ipairs(LastResults) do

            if MatchesFilter(scriptData) then

                local title =
                    scriptData.title
                    or "Unknown Script"

                local slug =
                    scriptData.slug

                if slug then

                    local rawURL =
                        "https://scriptblox.com/api/script/raw/"
                        .. slug

                    local loadstringCode =
                        'loadstring(game:HttpGet("'
                        .. rawURL
                        .. '"))()'

                    Window:AddButton(
                        ScriptbloxApis,
                        title,
                        "Copy Loadstring",
                        Icon,
                        function()

                            if setclipboard then

                                setclipboard(
                                    loadstringCode
                                )

                                print(
                                    "[ScriptBlox] Copied:",
                                    title
                                )

                            else

                                warn(
                                    "[ScriptBlox] setclipboard unavailable"
                                )

                            end

                        end
                    )

                    shown =
                        shown + 1
                end
            end
        end

        print(
            "[ScriptBlox] Found:",
            #LastResults,
            "| Showing:",
            shown,
            "| Filter:",
            CurrentFilter
        )

    end
)

